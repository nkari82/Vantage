# Vantage runtime token template
# Copy the values you need into /etc/vantage/backend.env on the target machine.
# For local testing on Windows, you can also export these in your shell before starting the server.

# Canonical token for protected backend system-control APIs.
# This token is returned by POST /api/login after successful login.
VANTAGE_SYSTEM_TOKEN=replace-with-strong-random-token

# Canonical token for vantage-llm-gateway internal calls to the backend.
# Default local/runtime fallback is x unless you explicitly override it.
VANTAGE_LLM_GATEWAY_TOKEN=x
