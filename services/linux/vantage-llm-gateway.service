[Unit]
Description=Vantage LLM Gateway Service
After=network-online.target vantage-backend.service vllm-coder.service
Wants=network-online.target

[Service]
Type=simple
User=vantage
Group=vantage
WorkingDirectory=/opt/vantage/services/llm-gateway
Environment=NODE_ENV=production
Environment=VANTAGE_LLM_GATEWAY_PORT=8080
Environment=VANTAGE_BACKEND_URL=http://127.0.0.1:18080
Environment=VANTAGE_UPSTREAM_URL=http://127.0.0.1:8000
Environment=VANTAGE_AUTO_START_VLLM=true
EnvironmentFile=-/etc/vantage/backend.env
ExecStart=/usr/bin/node /opt/vantage/services/llm-gateway/dist/index.js
Restart=always
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vantage-llm-gateway
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/vantage
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
