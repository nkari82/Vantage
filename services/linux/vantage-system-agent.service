[Unit]
Description=Vantage System Agent Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vantage
Group=vantage
WorkingDirectory=/opt/vantage/services/system-agent
Environment=NODE_ENV=production
Environment=VANTAGE_SYSTEM_AGENT_PORT=18081
ExecStart=/usr/bin/node /opt/vantage/services/system-agent/dist/index.js
Restart=always
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vantage-system-agent
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/vantage
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
