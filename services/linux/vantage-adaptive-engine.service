[Unit]
Description=Vantage Adaptive Engine Service
After=network-online.target vantage-backend.service
Wants=network-online.target

[Service]
Type=simple
User=vantage
Group=vantage
WorkingDirectory=/opt/vantage/services/adaptive-engine
Environment=NODE_ENV=production
Environment=VANTAGE_BACKEND_URL=http://127.0.0.1:18080
Environment=VANTAGE_ADAPTIVE_POLL_MS=15000
ExecStart=/usr/bin/node /opt/vantage/services/adaptive-engine/dist/index.js
Restart=always
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vantage-adaptive-engine
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/vantage
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
