[Unit]
Description=Vantage Dashboard Service
After=network-online.target vantage-backend.service
Wants=network-online.target

[Service]
Type=simple
User=vantage
Group=vantage
WorkingDirectory=/opt/vantage/apps/dashboard
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/bash -lc 'if [ -f /opt/vantage/apps/dashboard/server.js ]; then node /opt/vantage/apps/dashboard/server.js; else python3 -m http.server 3000 --directory /opt/vantage/apps/dashboard; fi'
Restart=always
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vantage-dashboard
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/vantage

[Install]
WantedBy=multi-user.target
