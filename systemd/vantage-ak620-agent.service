[Unit]
Description=Vantage AK620 Agent
After=network-online.target vantage-backend.service
Wants=network-online.target
PartOf=vantage-backend.service

[Service]
Type=simple
User=vantage
Group=vantage
WorkingDirectory=/opt/vantage/services/ak620-agent
Environment=AK620_REFRESH_INTERVAL=4
ExecStart=/usr/bin/node /opt/vantage/services/ak620-agent/dist/index.js
Restart=always
RestartSec=10
StartLimitIntervalSec=300
StartLimitBurst=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vantage-ak620-agent
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/vantage

[Install]
WantedBy=multi-user.target
